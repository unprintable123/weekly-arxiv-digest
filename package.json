{
  "name": "weekly-arxiv-digest-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "digest": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "site:css": "tailwindcss -i web/app.css -o web/assets/app.css --minify",
    "site:build": "node scripts/build-site.mjs",
    "site:deploy": "pnpm site:build && node scripts/deploy-site.mjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "date-fns": "^4.4.0",
    "p-limit": "^7.3.1",
    "sql.js": "^1.14.2",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/sql.js": "^1.4.11",
    "@tailwindcss/cli": "^4.1.13",
    "tailwindcss": "^4.1.13",
    "eslint": "^10.9.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}